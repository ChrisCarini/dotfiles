set_colors() {
  RESET=$'\e[0m'
  BOLD=$'\e[1m'
  UNDERLINE=$'\e[4m'
  NO_UNDERLINE=$'\e[24m'

  # Normal colors (ANSI 30-37)
  BLACK=$'\e[30m'
  RED=$'\e[31m'
  GREEN=$'\e[32m'
  YELLOW=$'\e[33m'
  BLUE=$'\e[34m'
  VIOLET=$'\e[35m'
  CYAN=$'\e[36m'
  WHITE=$'\e[37m'

  # Bright colors (ANSI 90-97)
  BRIGHT_GREEN=$'\e[92m'
  BRIGHT_YELLOW=$'\e[93m'
  BRIGHT_BLUE=$'\e[94m'
  BRIGHT_VIOLET=$'\e[95m'
  BRIGHT_CYAN=$'\e[96m'
  BRIGHT_WHITE=$'\e[97m'

  # Bold colors
  BLACK_BOLD=$'\e[1;30m'
  RED_BOLD=$'\e[1;31m'
  GREEN_BOLD=$'\e[1;32m'
  YELLOW_BOLD=$'\e[1;33m'
  BLUE_BOLD=$'\e[1;34m'
  VIOLET_BOLD=$'\e[1;35m'
  CYAN_BOLD=$'\e[1;36m'
  WHITE_BOLD=$'\e[1;37m'

  # Background colors (ANSI 40-47, 49)
  BACKGROUND_BLACK=$'\e[40m'
  BACKGROUND_RED=$'\e[41m'
  BACKGROUND_GREEN=$'\e[42m'
  BACKGROUND_YELLOW=$'\e[43m'
  BACKGROUND_BLUE=$'\e[44m'
  BACKGROUND_VIOLET=$'\e[45m'
  BACKGROUND_CYAN=$'\e[46m'
  BACKGROUND_WHITE=$'\e[0m'
  BACKGROUND_DEFAULT=$'\e[49m'
}

escape_color() {
  local ESC_OPEN="\["
  local ESC_CLOSE="\]"
  echo "${ESC_OPEN}$1${ESC_CLOSE}"
}

unset_colors() {
  unset RESET BOLD UNDERLINE NO_UNDERLINE
  unset BLACK RED GREEN YELLOW BLUE VIOLET CYAN WHITE
  unset BRIGHT_GREEN BRIGHT_YELLOW BRIGHT_BLUE BRIGHT_VIOLET BRIGHT_CYAN BRIGHT_WHITE
  unset BLACK_BOLD RED_BOLD GREEN_BOLD YELLOW_BOLD BLUE_BOLD VIOLET_BOLD CYAN_BOLD WHITE_BOLD
  unset BACKGROUND_BLACK BACKGROUND_RED BACKGROUND_GREEN BACKGROUND_YELLOW BACKGROUND_BLUE BACKGROUND_VIOLET BACKGROUND_CYAN BACKGROUND_WHITE BACKGROUND_DEFAULT
}

set_colors
unset set_colors
