# Configure grep defaults.
#
# These options are universally supported on macOS (BSD grep) and modern Linux
# (GNU grep). Previously tested at startup via `is-supported` subprocesses
# (~60ms); hardcoded here since the capabilities haven't changed in decades.

GREP_OPTIONS=" --line-number"
GREP_OPTIONS+=" --color=auto"
for PATTERN in .cvs .git .hg .svn venv; do
  GREP_OPTIONS+=" --exclude-dir=$PATTERN"
done

# Trim leading whitespace (pure bash, no xargs subprocess)
GREP_OPTIONS="${GREP_OPTIONS# }"

unset PATTERN
alias grep="grep $GREP_OPTIONS"
export GREP_COLOR='1;32'
