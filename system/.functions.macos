# Open man page as PDF
manpdf() {
  man -t "$1" | open -f -a /Applications/Preview.app/
}

# Convert Markdown files to PDF; the way I like (so far)
markdown2pdf() {
    if [ $# -ne 2 ]; then
        echo "markdown2pdf <input.md> <output.pdf>"
        return 1
    fi
    pandoc $1 \
    -t pdf \
    -V colorlinks=true \
    -V linkcolor=blue \
    -V urlcolor=blue \
    -V toccolor=gray \
    -V geometry:margin=0.5in \
    -o $2
}

set_terminal_title() {
  TITLE=$1
  printf "\e]0;${TITLE}\a"
}
set_terminal_color() {
  # Yellow
  osascript -e "tell application \"Terminal\" to set background color of front window to {65535, 65535, 0}"
}
flash_terminal_color() {
  # Get the current tty name (e.g., /dev/ttys000)
  CURRENT_TTY=$(tty)

  # Use osascript to find the window ID matching the tty name
  WINDOW_ID=$(osascript <<EOF
  tell application "Terminal"
  	set window_list to every window
  	repeat with a_window in window_list
  		try
  			set tty_name to tty of selected tab of a_window
  			if tty_name is equal to "$CURRENT_TTY" then
  				return id of a_window
  			end if
  		end try
  	end repeat
  end tell
EOF
  )

  echo "Current Terminal Window ID: ${WINDOW_ID}"
  ORIGINAL_COLOR=$(osascript -e "tell application \"Terminal\" to get background color of window id ${WINDOW_ID}")
  echo "Current Terminal Window Color: ${ORIGINAL_COLOR}"

  osascript -e "tell application \"Terminal\" to set background color of window id ${WINDOW_ID} to {65535, 0, 0}"
  sleep 1
  osascript -e "tell application \"Terminal\" to set background color of window id ${WINDOW_ID} to {65535, 65535, 0}"
  sleep 1
  osascript -e "tell application \"Terminal\" to set background color of window id ${WINDOW_ID} to {65535, 0, 0}"
  sleep 1
  osascript -e "tell application \"Terminal\" to set background color of window id ${WINDOW_ID} to {65535, 65535, 0}"
  sleep 1
  osascript -e "tell application \"Terminal\" to set background color of window id ${WINDOW_ID} to {${ORIGINAL_COLOR}}"

  return
  # Reset to white background
  osascript -e "tell application \"Terminal\" to set background color of window id ${WINDOW_ID} to {65535, 65535, 65535}"
}

notify() {
  TITLE=$1
  SUBTITLE=$2
  BODY=$3

  # SOUND_NAME="Submarine" # We should never be in a submarine.
  # SOUND_NAME="Basso" # Fail
  # SOUND_NAME="Glass" # Pass
  SOUND_NAME=$4
  if [[ -z "$SOUND_NAME" ]]; then
    osascript -e "display notification \"${BODY}\" with title \"${TITLE}\" subtitle \"${SUBTITLE}\""
  else
    osascript -e "display notification \"${BODY}\" with title \"${TITLE}\" subtitle \"${SUBTITLE}\" sound name \"${SOUND_NAME}\""
  fi
}

# See `.functions` for non-MacOS specific (ie, generic)
dingdingding() {
    local PREV_COMMAND_IN_PIPE_SUCCESS=$?
    local PREVIOUS_COMMAND=$(history 1 | head -n 1 | cut -d":" -f 4- | xargs | sed -E 's/[[:space:]]*((&&)|;)[[:space:]]*dingdingding[[:space:]]*//')

    if [ $PREV_COMMAND_IN_PIPE_SUCCESS -eq 0 ]; then
      RESULT_NOTIFY="Successful"
      RESULT_SAY="successfully"
      SOUND_NAME="Glass" # Pass
      HA_COLOR="lime green"
    else
      RESULT_NOTIFY="Error"
      RESULT_SAY="with an error"
      SOUND_NAME="Basso" # Fail
      HA_COLOR="red"
    fi
    # SOUND_NAME="Submarine" # We should never be in a submarine.
    # NOTE: Suppress "[0] <job_pid>" output via: https://stackoverflow.com/a/24844613
    { notify 'Ding Ding Ding!' "Finished (${RESULT_NOTIFY}): ${PREVIOUS_COMMAND}" '' "${SOUND_NAME}" 2>&3 & disown ; } 3>&2 2>/dev/null
    { say "Ding Ding Ding! Finished running ${PREVIOUS_COMMAND} ${RESULT_SAY}" 2>&3 & disown ; } 3>&2 2>/dev/null

    tput bel;sleep 0.5;
    tput bel;sleep 0.5;
    tput bel
    wait  # wait for the background jobs to finish
}

# `is_host_up` and `is_host_ssh` live in `.functions` (always sourced first).
# On MacOS we only override their notification hooks so they fire a desktop
# notification when the host/SSH becomes ready.
__is_host_up_notify() {
	notify 'Host is ping-able!' "Host $1 is responding to pings." '' 'Glass'
}
__is_host_ssh_notify() {
	notify 'SSH is Up!' "SSH on $1:$2 is accepting connections." '' 'Glass'
}

gource_me() {
  if [ ! -z $1 ] ;  then
      # --user-image-dir ~/path/to/images/formatted/developer/name/from/git/commit/log/dot/png/example/Chris Carini.png
      IMAGE_REPO="--user-image-dir ${1}"
  else
      IMAGE_REPO=""
  fi

  MAIN_BRANCH=$(git remote show origin | sed -n '/HEAD branch/s/.*: //p')
  PROJECT_NAME=${PWD##*/}
  COMMIT_COUNT=$(git rev-list --count $MAIN_BRANCH)

  echo "Run gource for ${PROJECT_NAME} over ${COMMIT_COUNT} commits on ${MAIN_BRANCH} branch?"

  read -p "Proceed? [y/N] " -n 1 -r
  echo    # (optional) move to a new line
  if [[ ! $REPLY =~ ^[Yy]$ ]]
  then
      echo "Exiting..."
      return 1
  fi

  gource \
    --seconds-per-day 0.1 \
    --date-format "${PROJECT_NAME} - %Y-%m-%dT%H:%M:%S" \
    $IMAGE_REPO \
    --hide filenames,dirnames,root \
    -1280x720 \
    -o "gource-${PROJECT_NAME}.ppm"

  ffmpeg \
    -y -r 60 \
    -f image2pipe -vcodec ppm \
    -i "gource-${PROJECT_NAME}.ppm" \
    -vcodec libx264 \
    -preset medium \
    -pix_fmt yuv420p \
    -crf 1 \
    -threads 0 \
    -bf 0 \
    "gource-${PROJECT_NAME}.mp4"

  echo "Two files created:"
  ls -lash gource*.{ppm,mp4} 2>/dev/null

  read -p "Open video? [y/N] " -n 1 -r
  echo    # (optional) move to a new line
  if [[ ! $REPLY =~ ^[Yy]$ ]]
  then
      echo 'Ok. Done!'
      return 0
  fi
  open gource-*.mp4
}

remount_rw() {
    local input="$1"
    local dev mountpoint fstype

    if [[ -z "$input" ]]; then
        echo "Usage: remount_rw <device|mountpoint> [mountpoint]"
        return 1
    fi

    if [[ "$input" == /Volumes/* || "$input" == /* ]]; then
        # Input is a mount point
        mountpoint="$input"
        dev=$(df "$mountpoint" 2>/dev/null | awk 'NR==2 {print $1}')
        [[ -n "$dev" ]] || {
            echo "No filesystem mounted at '$mountpoint'"
            return 1
        }
    else
        # Input is a device
        dev="/dev/${input#/dev/}"
        mountpoint="${2:-$(diskutil info "$dev" | awk -F': *' '/Mount Point/ {print $2}')}"
        [[ "$mountpoint" == "Not Mounted" || -z "$mountpoint" ]] && {
            mountpoint="${2:-/Volumes/$(basename "$dev")}"
        }
    fi

    fstype=$(diskutil info "$dev" | awk -F': *' '/Type \(Bundle\)/ {print tolower($2)}')

    [[ -n "$fstype" ]] || {
        echo "Could not determine filesystem type."
        return 1
    }

    sudo diskutil unmount "$dev" || return 1
    sudo mkdir -p "$mountpoint"

    case "$fstype" in
        apfs|hfs|msdos|exfat)
            sudo mount -t "$fstype" -o rw "$dev" "$mountpoint" ||
            [[ "$fstype" == exfat ]] && sudo /sbin/mount_exfat "$dev" "$mountpoint"
            ;;
        *)
            echo "Unsupported filesystem: $fstype"
            return 1
            ;;
    esac
}

# Borrowed from StackOverflow
# Ref: https://stackoverflow.com/a/30029855
listening() {
  if [ $# -eq 0 ]; then
    sudo lsof -iTCP -sTCP:LISTEN -n -P
  elif [ $# -eq 1 ]; then
    sudo lsof -iTCP -sTCP:LISTEN -n -P | grep -i --color $1
  else
    echo "Usage: listening [pattern]"
  fi
}
open-ports() {
  listening $1
}

function countdown() {
  # Run as `countdown <seconds_to_countdown>`
  #  countdown 10    # 10 seconds
  #  countdown 60    # 1 minute
  #  countdown 300   # 5 minutes
  local now=$(date +%s)
  local end=$((now + $1))
  local now_fmt=$(date -u -j -f %s "$now" +"%Y-%m-%d %H:%M:%S")
  local end_fmt=$(date -u -j -f %s "$end" +"%Y-%m-%d %H:%M:%S")
  while ((now < end)); do
    printf "[start: %s | end: %s] %s\r" "${now_fmt}" "${end_fmt}" "$(date -u -j -f %s $((end - now)) +%T)"
    sleep 0.5
    now=$(date +%s)
  done
  echo
}

make-hdr() {
  ##
  # Requires installation of Luminance version 2.6.1 (downloaded from https://github.com/LuminanceHDR/LuminanceHDR/issues/192#issuecomment-1194372488 )
  # AS OF 2024-04-21, above is not working (dead link), so I installed via macports: `sudo port install luminance-hdr`
  ##
  FILE_EXTENSION=NEF

  if compgen -G "*.exr" >/dev/null && compgen -G "*.tif" >/dev/null; then
    echo "Both the 'exr' and 'tif' file exists. Skipping [$(pwd)] directory..."
    return
  fi
  echo "Creating High Dynamic Range photo for [$(pwd)] directory..."

  /Applications/MacPorts/Luminance\ HDR.app/Contents/MacOS/luminance-hdr-cli \
    --align AIS \
    --gamma 1 \
    --saturation 1 \
    --postgamma 1 \
    \
    --hdrModel debevec \
    --hdrWeight triangular \
    --hdrResponseCurve gamma \
    \
    --tmo drago \
    --tmoDrgBias "0.75" \
    \
    --ldrQuality 100 \
    --ldrTiff 16b \
    --proposedldrname tif \
    --proposedhdrname exr \
    \
    *.$FILE_EXTENSION
}

make-all-hdr() {
  # Run this from within a 'year' directory. (ie, `./Photos/20xx/`)
  BASE_DIR="."
  for i in $BASE_DIR/*/HDR_*; do
    echo
    echo "Current Dir: ${i}"
    pushd "${i}" >/dev/null
    make-hdr
    popd >/dev/null
  done
}


function idea-format() {
#  /Applications/IntelliJ\ IDEA\ Ultimate\ \(OSS\ License\).app/Contents/bin/format.sh -s "$BASE/lnkd_style.xml" "${@}" &
  /Applications/IntelliJ\ IDEA\ CE.app/Contents/bin/format.sh -s "$BASE/lnkd_style.xml" "${@}" &
  sleep 10 ; ps aux | \grep "idea format" | awk '{print $2}' | xargs kill -9 > /dev/null 2>&1 &
}