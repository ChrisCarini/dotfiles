# Start with system path; retrieve it from getconf, otherwise it's just current $PATH
is-executable getconf && PATH=$($(command -v getconf) PATH)

# Append new items to path (if directory exists)
PATH=""
append_path "/opt/homebrew/bin"
append_path "/bin"
append_path "/usr/local/bin"
append_path "/usr/bin"
append_path "$DOTFILES_DIR/bin"
#append_path "$HOME/bin"
append_path "/sbin"
append_path "/usr/sbin"
append_path "/usr/local/sbin"

# Add golang to path
export GOPATH="$HOME/go"
append_path "$GOPATH/bin"

# Remove duplicates in PATH (pure bash, no subprocesses)
_dedup_path() {
    local IFS=: new_path="" seen="" p
    for p in $PATH; do
        case ":$seen:" in
            *":$p:"*) ;;
            *) new_path="${new_path:+$new_path:}$p"; seen="$seen:$p" ;;
        esac
    done
    PATH="$new_path"
}
_dedup_path
unset -f _dedup_path

# Wrap up
export PATH
